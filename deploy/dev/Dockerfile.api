FROM mcr.microsoft.com/dotnet/sdk:10.0@sha256:e70cdb7f80b0348f5cb85f19a8f670fca061f033d57eed12fa003d58b0e06317 AS build
WORKDIR /source
COPY global.json Directory.Build.props LICENSE THIRD_PARTY_NOTICES.md ./
COPY src/RdWeb.Api/ src/RdWeb.Api/
RUN dotnet restore src/RdWeb.Api --locked-mode && dotnet publish src/RdWeb.Api -c Release --no-restore -o /out

# 標準 Ubuntu 映像包含 tzdata 與 ICU，保留完整 IANA 時區轉換能力。
FROM mcr.microsoft.com/dotnet/aspnet:10.0@sha256:222759b391a1aaf241166672c8f99b2d4ada452e7b5319f3c6e8f265a37b5ad4
WORKDIR /app
COPY --from=build /out ./
ENV ASPNETCORE_HTTP_PORTS=8080 LOG_TIME_ZONE=UTC TZ=UTC
USER app
EXPOSE 8080
ENTRYPOINT ["dotnet", "RdWeb.Api.dll"]
