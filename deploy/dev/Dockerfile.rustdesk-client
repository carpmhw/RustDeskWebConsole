FROM debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587
# 官方 release 固定版本及公開 digest；圖形套件已取得使用者同意，僅供 M0 測試。
ADD --checksum=sha256:e5b8a1bb3ea697716263c9309c79db667aedb3e024400dc3d07f5aaa0edfb907 https://github.com/rustdesk/rustdesk/releases/download/1.4.2/rustdesk-1.4.2-x86_64.deb /tmp/rustdesk.deb
# 上游以 /usr 路徑判定已安裝模式，放到 /opt 可在非 root 的 portable 模式使用。
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    /tmp/rustdesk.deb xvfb fluxbox dbus-x11 x11-utils x11-apps procps ca-certificates fonts-dejavu-core libegl1 libegl-mesa0 \
    && rm -rf /var/lib/apt/lists/* /tmp/rustdesk.deb \
    && mv /usr/share/rustdesk /opt/rustdesk && ln -sf /opt/rustdesk/rustdesk /usr/bin/rustdesk \
    && useradd -m -u 1000 rdtest && mkdir /test-state && chown rdtest:rdtest /test-state
COPY deploy/dev/entrypoint-rustdesk-client.sh /entrypoint.sh
COPY LICENSE THIRD_PARTY_NOTICES.md /usr/share/doc/rdweb/
RUN mkdir /target-config && chown rdtest:rdtest /target-config
ENV DISPLAY=:99 XDG_CONFIG_HOME=/home/rdtest/.config RUST_LOG=off LIBGL_ALWAYS_SOFTWARE=1
USER rdtest
ENTRYPOINT ["sh", "/entrypoint.sh"]
