FROM rustdesk/rustdesk-server:1.1.14@sha256:680f8ba5accafc264d15076f33a6fdb9cb6f4d963a0fc92e01023ca0e919cc83 AS upstream
FROM debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587
RUN apt-get update && apt-get install -y --no-install-recommends netcat-openbsd ca-certificates && rm -rf /var/lib/apt/lists/* \
    && useradd -m -u 1000 rdtest && mkdir /data /public-key && chown rdtest:rdtest /data /public-key
COPY --from=upstream /usr/bin/hbbs /usr/bin/hbbr /usr/local/bin/
COPY deploy/dev/entrypoint-rustdesk-server.sh /entrypoint.sh
COPY LICENSE THIRD_PARTY_NOTICES.md /usr/share/doc/rdweb/
WORKDIR /data
USER rdtest
ENTRYPOINT ["sh", "/entrypoint.sh"]
