worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 1024; }
http {
  # 請求錯誤常附帶原始 URL／Referer，丟棄此層輸出以免記錄票證；主層保留啟動診斷。
  error_log /dev/null;
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  access_log off;
  client_body_temp_path /tmp/client_body;
  proxy_temp_path /tmp/proxy;
  # 其餘模組的暫存路徑同樣放在 /tmp，映像內目錄不需可寫，單容器可唯讀根檔案系統。
  fastcgi_temp_path /tmp/fastcgi;
  uwsgi_temp_path /tmp/uwsgi;
  scgi_temp_path /tmp/scgi;
  map $http_upgrade $connection_upgrade { default upgrade; '' close; }
  server {
    listen ${GATEWAY_LISTEN_PORT};
    # 正式部署由 OUTER_PROXY_ADDRESSES 產生 realip 設定；之後 $remote_addr 即真實用戶端，dev 未設定時為空。
    ${REAL_IP_CONFIG}
    root ${GATEWAY_ROOT};
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Cache-Control no-store always;
    add_header Referrer-Policy no-referrer always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:; base-uri 'self'; frame-ancestors 'none'; object-src 'none'" always;
    location ~ ^(${BASE})?/api/ {
      rewrite ^(${BASE})?(/api/.*)$ $2 break;
      proxy_pass http://${GATEWAY_UPSTREAM};
      proxy_http_version 1.1;
      proxy_set_header Host $http_host;
      proxy_set_header X-Forwarded-Host $host;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Forwarded-Prefix "${BASE}";
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_read_timeout 3600s;
      proxy_send_timeout 3600s;
      proxy_buffering off;
    }
    location / {
      rewrite ^${BASE}(/.*)$ $1 break;
      try_files $uri $uri/ /index.html;
    }
  }
}
