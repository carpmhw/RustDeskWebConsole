# 單容器正式映像：nginx（與兩容器 web 同一 digest）＋後端，由 rdweb-entrypoint.sh 監督。
FROM mcr.microsoft.com/dotnet/sdk:10.0@sha256:e70cdb7f80b0348f5cb85f19a8f670fca061f033d57eed12fa003d58b0e06317 AS backend
WORKDIR /source
COPY global.json Directory.Build.props LICENSE THIRD_PARTY_NOTICES.md ./
COPY src/RdWeb.Api/ src/RdWeb.Api/
RUN dotnet restore src/RdWeb.Api --locked-mode && dotnet publish src/RdWeb.Api -c Release --no-restore -o /out

FROM node:24-bookworm-slim@sha256:d6aa754f16b3197301076f047b5def2f02ea1dbbc2ca920407d46d7ec7f87b20 AS frontend
WORKDIR /source
COPY frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml ./
COPY frontend/patches/ ./patches/
RUN corepack pnpm install --frozen-lockfile
COPY frontend/ ./
RUN corepack pnpm build

# 只取官方可攜 .NET runtime；Debian 13 在 .NET 10 支援清單內，等同官方 tar 檔安裝方式。
FROM mcr.microsoft.com/dotnet/aspnet:10.0@sha256:222759b391a1aaf241166672c8f99b2d4ada452e7b5319f3c6e8f265a37b5ad4 AS dotnet

FROM nginx:stable-trixie@sha256:42c68eab6f7e22611786a9fe1d1c019e275c50185bd54b8f75dc2b9184322703
# 基底已含 tzdata、OpenSSL、libstdc++、zlib 與 ca-certificates；.NET 另需 ICU（保留完整 IANA 時區與全球化）。
RUN apt-get update \
  && apt-get install -y --no-install-recommends libicu76 \
  && rm -rf /var/lib/apt/lists/*
COPY --from=dotnet /usr/share/dotnet /usr/share/dotnet
# 與 aspnet 映像相同的 app 使用者（uid／gid 1654），資料目錄預建為 0700，新 volume 繼承擁有者與權限。
RUN ln -s /usr/share/dotnet/dotnet /usr/bin/dotnet \
  && groupadd -g 1654 app \
  && useradd -u 1654 -g app -M -d /app -s /usr/sbin/nologin app \
  && mkdir -p /app/data \
  && chown app:app /app/data \
  && chmod 700 /app/data
WORKDIR /app
COPY --from=backend /out ./
COPY --from=frontend /source/dist/ /usr/share/nginx/html/
COPY LICENSE THIRD_PARTY_NOTICES.md /usr/share/nginx/html/
COPY deploy/dev/nginx.conf.template deploy/dev/validate-outer-proxy.sh deploy/dev/render-gateway.sh /etc/rdweb/
COPY deploy/single/rdweb-entrypoint.sh deploy/single/rdweb-healthcheck.sh /usr/local/bin/
ENV DOTNET_ROOT=/usr/share/dotnet LOG_TIME_ZONE=UTC TZ=UTC
USER app
EXPOSE 8000
# nginx 基底預設 STOPSIGNAL 為 SIGQUIT；監督腳本（PID 1）以 SIGTERM 轉送停止給兩個程序。
STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/local/bin/rdweb-entrypoint.sh"]
