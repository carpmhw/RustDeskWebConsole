{
  "name": "rdweb-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "generate": "node scripts/generate-rustdesk-proto.mjs",
    "build": "node scripts/generate-rustdesk-proto.mjs && vue-tsc --noEmit && vite build",
    "typecheck:text-return-probe": "tsc --project e2e/config/tsconfig.text-return-probe.json",
    "test": "node scripts/generate-rustdesk-proto.mjs && vitest run",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "e2e": "playwright test --config e2e/config/playwright.config.ts"
  },
  "dependencies": {
    "fzstd": "0.1.1",
    "pinia": "4.0.3",
    "protobufjs": "8.8.0",
    "qrcode": "1.5.4",
    "tweetnacl": "1.0.3",
    "vue": "3.5.43",
    "vue-i18n": "11.4.13",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.9",
    "eslint": "10.12.0",
    "eslint-plugin-vue": "10.11.1",
    "prettier": "3.9.9",
    "protobufjs-cli": "2.7.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.12"
  }
}
