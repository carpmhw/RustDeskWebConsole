+                    err(0);
                 for (var i = 0; i < ll; ++i) {
                     buf[oubt + i] = buf[spl + i];
                 }
@@ -550,6 +566,9 @@ var rzb = function (dat, st, out) {
                 if (stin < 0) {
                     var len = -stin;
                     var bs = st.e + stin;
+                    // 指向 window 外的歷史不可被 undefined 轉為零 byte。
+                    if (bs < 0)
+                        err(0);
                     if (len > ml)
                         len = ml;
                     for (var i = 0; i < len; ++i) {
@@ -563,6 +582,9 @@ var rzb = function (dat, st, out) {
                 oubt += ml;
             }
             if (oubt != spl) {
+                // 最後未使用 literal 亦須驗額，不能在尾端默默丟失。
+                if (buf.length - spl > buf.length - oubt)
+                    err(0);
                 while (spl < buf.length) {
                     buf[oubt++] = buf[spl++];
                 }
@@ -631,6 +653,10 @@ export function decompress(dat, buf) {
                 var blk = rzb(dat, st, buf);
                 if (!blk)
                     err(5);
+                // one-shot 同樣驗 frame 真長度，不信任預配置 FCS buffer。
+                st.p = buf ? st.y : st.p + blk.length;
+                if (st.f && (st.p > st.u || (st.l && st.p != st.u)))
+                    err(0);
                 if (buf)
                     st.e = st.y;
                 else {
@@ -733,6 +759,10 @@ var Decompress = /*#__PURE__*/ (function () {
                     return;
                 }
                 else {
+                    // 結果 callback 之前驗真輸出，末 block 必須恰等 FCS。
+                    this.s.p += blk.length;
+                    if (this.s.f && (this.s.p > this.s.u || (this.s.l && this.s.p != this.s.u)))
+                        err(0);
                     this.ondata(blk, false);
                     cpw(this.s.w, 0, blk.length);
                     this.s.w.set(blk, this.s.w.length - blk.length);
